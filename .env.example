SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_UPLOAD_WORKER_URL=https://your-image-uploader.example.com/upload

# Optional legacy owner login. Store member logins are managed in the database.
# ADMIN_EMAIL=
# It is only for the old legacy owner login. The two new store accounts are managed through the team_members database table. Do not enter either store email here, or that account may fail to log in.
AUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
